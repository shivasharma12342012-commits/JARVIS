# Byte-compiled artefacts: regenerated on every run, never worth reviewing.
__pycache__/
*.py[cod]

# Runtime state, local to one machine.
logs/
.jarvis_cache/
.jarvis_profile.json
.jarvis_theme.json
.jarvis_greetings.json
.jarvis_voiceprint.json
# The sign-in credential: a scrypt hash, but still this machine's and not
# the project's. Nothing here ever contains a password in the clear.
.jarvis_credentials.json
.env

# Environments and test caches.
.venv/
venv/
.pytest_cache/
